{
  "name": "buisbuid-dashboard",
  "version": "1.0.0",
  "description": "A professional business consultancy website built with modern web technologies and best practices.",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --minify",
    "build:css:dev": "npx tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css",
    "deploy": "gh-pages -d .",
    "watch:css": "npx tailwindcss -i ./assets/css/input.css -o ./assets/css/styles.css --watch",
    "serve": "python3 -m http.server 8000",
    "dev": "npm run build:css:dev && npm run serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuisBuid/buisbuid-dashboard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BuisBuid/buisbuid-dashboard/issues"
  },
  "homepage": "https://github.com/BuisBuid/buisbuid-dashboard#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.15"
  }
}
